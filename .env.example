# Required environment variables

# Supabase project URL (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: temporary site-wide password protection via Next.js proxy.ts
# Set to "true" to require HTTP Basic Auth for all non-static requests
SITE_PASSWORD_PROTECTION_ENABLED=false
SITE_ACCESS_USERNAME=admin
SITE_ACCESS_PASSWORD=replace-with-a-strong-random-password
