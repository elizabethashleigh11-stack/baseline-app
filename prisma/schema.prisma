generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CategoryPair {
  mainCategory String
  subcategory  String

  logEntries LogEntry[]

  @@id([mainCategory, subcategory])
}

model LogEntry {
  id           String   @id @default(cuid())
  mainCategory String
  subcategory  String
  notes        String?
  createdAt    DateTime @default(now())

  categoryPair CategoryPair @relation(fields: [mainCategory, subcategory], references: [mainCategory, subcategory], onDelete: Restrict, onUpdate: Restrict)

  @@index([mainCategory, subcategory])
}
